# OpenViking long-term memory is disabled by default so a fresh checkout runs
# without a local OpenViking server. To enable it, comment out this line and
# configure OPENVIKING_URL below.
RP_DISABLE_OPENVIKING=1

# Optional OpenViking connection. Leave the key and account empty for a local
# development server that does not require authentication.
#OPENVIKING_URL=http://127.0.0.1:1933
#OPENVIKING_API_KEY=
#OPENVIKING_ACCOUNT=
